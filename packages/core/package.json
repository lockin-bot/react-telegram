{
  "name": "@react-telegram/core",
  "version": "0.1.0",
  "description": "Core React reconciler for Telegram bots",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "bun": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:types",
    "build:types": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-reconciler": "^0.32.0"
  },
  "devDependencies": {
    "@types/react": "npm:pure-react-types@^0.1.4",
    "@types/react-reconciler": "^0.32.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "keywords": [
    "react",
    "telegram",
    "bot",
    "reconciler",
    "react-telegram"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/react-telegram.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/react-telegram/issues"
  },
  "homepage": "https://github.com/your-username/react-telegram#readme"
}